# Copia este archivo como .env y pon los datos de tu proyecto Supabase
# (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Dominio interno para convertir "usuario" en correo (no se envían correos)
VITE_USER_DOMAIN=usuarios.gestoragua.app
